#!/usr/bin/env python3
"""supermatt: pipeline state, per-repo options and enforcement hooks.

A repo opts in by having `.supermatt/config.json` (written by `supermatt init`).
Without it every hook is a no-op, so the plugin never touches other repos.

The config names a test command that hooks run on their own, so a config is
only acted on once this machine trusts it: `init` and `config` trust what they
write, and a config that arrives any other way (a clone, a pull) waits for
`supermatt trust`. Trust is keyed on the repo path and the config's exact bytes.
"""
import argparse
import functools
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile

CONFIG = ".supermatt/config.json"
STATE = ".supermatt/state.json"
STAGES = ("grill", "spec", "tickets", "implement", "verify", "finish", "done")
TICKET_STATES = ("implementing", "blocked", "needs-review", "done")
LEVELS = ("off", "warn", "block")
RULES = ("tests_before_commit", "ticket_before_code", "review_after_ticket", "green_before_stop")
PRESETS = {
    "strict": dict.fromkeys(RULES, "block"),
    "standard": {"tests_before_commit": "block", "ticket_before_code": "warn",
                 "review_after_ticket": "block", "green_before_stop": "block"},
    "light": dict.fromkeys(RULES, "warn"),
    # One developer moving fast: the commit gate stays, the per-turn and per-edit checks go.
    "solo": {"tests_before_commit": "block", "ticket_before_code": "off",
             "review_after_ticket": "warn", "green_before_stop": "off"},
    "off": dict.fromkeys(RULES, "off"),
}
DEFAULTS = {
    "test_command": None,
    "test_timeout": 300,
    "exempt": [".scratch/*", "docs/*", ".supermatt/*", "*.md"],
    "pipeline": {
        "interview": "full",
        "pause_at": ["implement", "finish"],
        "branch": True,
        "branch_prefix": "",
        "worktree": False,
        "ticket_agents": False,
        "review_agents": False,
        "finish": "ask",
    },
    "enforce": PRESETS["standard"],
}
CHOICES = {
    "pipeline.interview": ("full", "auto"),
    "pipeline.finish": ("ask", "merge", "push", "pr", "keep"),
    **{"enforce." + r: LEVELS for r in RULES},
}
MAX_STOP_BLOCKS = 3
MAX_TEST_TIMEOUT = 570  # the commit and stop hooks are given 600s in hooks.json
GIT_COMMIT = re.compile(r"(^|[;&|(\s])git(\s+-\S+(\s+\S+)?)*\s+commit(?![\w-])")
TICKET_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9#._-]*")
EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")


class UsageError(Exception):
    pass


# ---------- repo, config, state ----------

def repo_root(cwd):
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd,
                             capture_output=True, text=True)
    except OSError:
        return os.path.realpath(cwd)
    return os.path.realpath(out.stdout.strip()) if out.returncode == 0 else os.path.realpath(cwd)


@functools.lru_cache(maxsize=None)
def state_home(root):
    """The main working tree for `root`, so every linked worktree shares its pipeline state and trust."""
    out = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=root, capture_output=True, text=True)
    if out.returncode != 0:
        return root
    common = os.path.realpath(os.path.join(root, out.stdout.strip()))
    return os.path.dirname(common) if os.path.basename(common) == ".git" else root


def merged(base, override):
    out = dict(base)
    for k, v in override.items():
        out[k] = merged(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    umask = os.umask(0)
    os.umask(umask)
    os.chmod(tmp, 0o666 & ~umask)  # mkstemp makes files 0600; give them normal permissions
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def load_config(root):
    """Return the effective config, or None when the repo has not opted in."""
    path = os.path.join(root, CONFIG)
    if not os.path.isfile(path):
        return None
    try:
        raw = read_json(path)
    except (OSError, ValueError) as e:
        raise UsageError(f"cannot read {CONFIG}: {e}")
    if not isinstance(raw, dict):
        raise UsageError(f"{CONFIG} must be a JSON object")
    config = merged(DEFAULTS, raw)
    problems = config_problems(config)
    if problems:
        raise UsageError(f"{CONFIG}: " + "; ".join(problems))
    return config


def config_problems(config):
    problems = []
    for key, allowed in CHOICES.items():
        section, name = key.split(".")
        if config[section].get(name) not in allowed:
            problems.append(f"{key} must be one of {', '.join(allowed)}")
    if not (config["test_command"] is None or isinstance(config["test_command"], str)):
        problems.append("test_command must be a string or null")
    if not (isinstance(config["test_timeout"], int) and 0 < config["test_timeout"] <= MAX_TEST_TIMEOUT):
        problems.append(f"test_timeout must be 1-{MAX_TEST_TIMEOUT} seconds (hooks are killed after 600)")
    if not (isinstance(config["exempt"], list) and all(isinstance(p, str) for p in config["exempt"])):
        problems.append("exempt must be a list of glob strings")
    pause_at = config["pipeline"]["pause_at"]
    if not (isinstance(pause_at, list) and all(s in STAGES for s in pause_at)):
        problems.append(f"pipeline.pause_at must be a list of stages ({', '.join(STAGES)})")
    if not (isinstance(config["pipeline"]["branch_prefix"], str)
            and re.fullmatch(r"[A-Za-z0-9._/-]*", config["pipeline"]["branch_prefix"])):
        problems.append("pipeline.branch_prefix must be a string of letters, digits and . _ / -")
    for name in ("branch", "worktree", "ticket_agents", "review_agents"):
        if not isinstance(config["pipeline"][name], bool):
            problems.append(f"pipeline.{name} must be true or false")
    return problems


# ---------- trust ----------

def trust_file():
    return os.environ.get("SUPERMATT_TRUST_FILE") or os.path.expanduser("~/.config/supermatt/trusted.json")


def config_digest(root):
    with open(os.path.join(root, CONFIG), "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def read_trust():
    try:
        data = read_json(trust_file())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def is_trusted(root):
    try:
        return read_trust().get(state_home(root)) == config_digest(root)
    except OSError:
        return False


def trust(root):
    data = read_trust()
    data[state_home(root)] = config_digest(root)
    write_json(trust_file(), data)


def require_config(root):
    config = load_config(root)
    if config is None:
        raise UsageError(f"no {CONFIG} in {root}; run `supermatt init` (or /supermatt:setup) first")
    return config


def load_state(root):
    state = {"feature": None, "stage": None, "base": None, "ticket": None, "tickets": {}, "green": None,
             "red": None, "stop_blocks": 0}
    try:
        saved = read_json(os.path.join(state_home(root), STATE))
    except (OSError, ValueError):
        return state
    if isinstance(saved, dict):
        for key, default in list(state.items()):
            value = saved.get(key, default)
            if key == "tickets":
                ok = isinstance(value, dict) and all(v in TICKET_STATES for v in value.values())
            elif key == "stop_blocks":
                ok = isinstance(value, int)
            else:
                ok = value is None or isinstance(value, str)
            state[key] = value if ok else default
    return state


def save_state(root, state):
    write_json(os.path.join(state_home(root), STATE), state)


# ---------- commands ----------

def cmd_init(args, root):
    path = os.path.join(root, CONFIG)
    if os.path.exists(path) and not args.force:
        raise UsageError(f"{CONFIG} already exists; use `supermatt config` to change options, or --force")
    raw = {"test_command": args.test_command, "enforce": PRESETS[args.preset]}
    write_json(path, raw)
    trust(root)
    ignore = os.path.join(root, ".gitignore")
    lines = open(ignore).read().splitlines() if os.path.exists(ignore) else []
    if STATE not in lines:
        with open(ignore, "a") as f:
            if lines and lines[-1] != "":
                f.write("\n")
            f.write(STATE + "\n")
    print(f"wrote {CONFIG} (preset {args.preset}); {STATE} is gitignored")


def cmd_config(args, root):
    config = require_config(root)
    if args.key is None:
        print(json.dumps(config, indent=2))
        return
    if args.key == "preset":
        if args.value not in PRESETS:
            raise UsageError(f"preset must be one of {', '.join(PRESETS)}")
        return set_raw(root, ["enforce"], PRESETS[args.value])
    keys = args.key.split(".")
    current = config
    for k in keys:
        if not isinstance(current, dict) or k not in current:
            raise UsageError(f"unknown option {args.key}")
        current = current[k]
    if args.value is None:
        print(json.dumps(current))
        return
    set_raw(root, keys, parse_value(args.key, current, args.value))


def parse_value(key, current, text):
    if key in CHOICES:
        if text not in CHOICES[key]:
            raise UsageError(f"{key} must be one of {', '.join(CHOICES[key])}")
        return text
    if key == "pipeline.pause_at":
        stages = [] if text == "none" else [s for s in text.split(",") if s]
        bad = [s for s in stages if s not in STAGES]
        if bad:
            raise UsageError(f"unknown stage(s) {', '.join(bad)}; stages are {', '.join(STAGES)}")
        return stages
    if key == "exempt":
        return [p for p in text.split(",") if p]
    if key == "pipeline.branch_prefix":
        if not re.fullmatch(r"[A-Za-z0-9._/-]*", text):
            raise UsageError("pipeline.branch_prefix may only use letters, digits and . _ / -")
        return text
    if isinstance(current, bool):
        if text not in ("true", "false"):
            raise UsageError(f"{key} must be true or false")
        return text == "true"
    if isinstance(current, int):
        try:
            return int(text)
        except ValueError:
            raise UsageError(f"{key} must be a number")
    if key == "test_command":
        return text or None
    raise UsageError(f"{key} cannot be set from the command line; edit {CONFIG}")


def set_raw(root, keys, value):
    path = os.path.join(root, CONFIG)
    was_trusted = is_trusted(root)
    raw = read_json(path)
    node = raw
    for k in keys[:-1]:
        node = node.setdefault(k, {})
    node[keys[-1]] = value
    write_json(path, raw)
    print(f"{'.'.join(keys)} = {json.dumps(value)}")
    if was_trusted:
        trust(root)  # our own edit to a config this machine already trusted
    else:
        print("note: this config is not trusted on this machine; review it, then run `supermatt trust`")


def cmd_status(args, root):
    config = load_config(root)
    state = load_state(root)
    if args.json:
        print(json.dumps({"root": root, "configured": config is not None, "trusted": config is not None and is_trusted(root),
                          "config": config, "state": state}, indent=2))
        return
    if config is None:
        print(f"supermatt: not set up in {root} (run /supermatt:setup)")
        return
    print(f"feature: {state['feature'] or '-'}")
    print(f"stage:   {state['stage'] or '-'}" + (f" (base branch {state['base']})" if state["base"] else ""))
    print(f"ticket:  {state['ticket'] or '-'}")
    for tid in sorted(state["tickets"]):
        print(f"  {tid}: {state['tickets'][tid]}")
    print(f"tests:   {config['test_command'] or '(none set)'}")
    if not is_trusted(root):
        print("trust:   NOT TRUSTED on this machine, so hooks are off. Review .supermatt/config.json, "
              "then run `supermatt trust`.")
    print("enforce: " + ", ".join(f"{r}={config['enforce'][r]}" for r in RULES))
    p = config["pipeline"]
    print(f"pipeline: interview={p['interview']} pause_at={','.join(p['pause_at']) or '-'} "
          f"branch={str(p['branch']).lower()}{' (prefix ' + p['branch_prefix'] + ')' if p['branch_prefix'] else ''} worktree={str(p['worktree']).lower()} "
          f"ticket_agents={str(p['ticket_agents']).lower()} review_agents={str(p['review_agents']).lower()} "
          f"finish={p['finish']}")


def cmd_start(args, root):
    require_config(root)
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args.feature):
        raise UsageError("feature slug must be lowercase letters, digits and hyphens")
    state = load_state(root)
    state.update(feature=args.feature, stage=args.stage, base=None, ticket=None, tickets={}, stop_blocks=0)
    save_state(root, state)
    print(f"feature {args.feature}: stage {args.stage}")


def cmd_stage(args, root):
    require_config(root)
    state = load_state(root)
    if not state["feature"]:
        raise UsageError("no active feature; run `supermatt start <feature>` first")
    state["stage"] = args.stage
    save_state(root, state)
    print(f"feature {state['feature']}: stage {args.stage}")


def cmd_base(args, root):
    require_config(root)
    state = load_state(root)
    if not state["feature"]:
        raise UsageError("no active feature; run `supermatt start <feature>` first")
    state["base"] = args.branch
    save_state(root, state)
    print(f"feature {state['feature']}: base branch {args.branch}")


def cmd_trust(args, root):
    config = require_config(root)
    trust(root)
    print(f"trusted {CONFIG} in {root}; hooks will run: {config['test_command'] or '(no test command)'}")


def cmd_test(args, root):
    config = require_config(root)
    if not is_trusted(root):
        raise UsageError(f"this machine has not trusted {CONFIG}; review it, then run `supermatt trust`")
    if not config["test_command"]:
        print("no test command set (`supermatt config test_command \"<cmd>\"`); nothing to run")
        return 0
    state = load_state(root)
    passed, tail, ran = ensure_green(config, root, state, force=args.force)
    save_state(root, state)
    if not ran:
        print(f"green: these files already passed `{config['test_command']}`, so it was not rerun (--force reruns it)")
        return 0
    print(f"$ {config['test_command']}\n{tail}\n{'green' if passed else 'red'}")
    return 0 if passed else 1


def cmd_ticket(args, root):
    config = require_config(root)
    if not TICKET_ID.fullmatch(args.id):
        raise UsageError("ticket id must be letters, digits and # . _ - (for example 03 or 123)")
    state = load_state(root)
    level = config["enforce"]["review_after_ticket"]
    problem = None
    if args.status == "implementing":
        pending = [t for t, s in state["tickets"].items() if s == "needs-review" and t != args.id]
        if pending:
            problem = f"ticket {', '.join(sorted(pending))} is committed but not reviewed; run /supermatt:review first"
    elif args.status == "done" and state["tickets"].get(args.id) in ("implementing", "blocked"):
        problem = f"ticket {args.id} goes to done only through review: mark it needs-review and run /supermatt:review"
    if problem and level == "block":
        raise UsageError(problem)
    if problem and level == "warn":
        print("supermatt warning: " + problem, file=sys.stderr)
    state["tickets"][args.id] = args.status
    if args.status != "done":
        state["ticket"] = args.id
    elif state["ticket"] == args.id:
        state["ticket"] = None
    save_state(root, state)
    print(f"ticket {args.id}: {args.status}")


# ---------- hooks ----------

def exempt(config, rel):
    return any(fnmatch.fnmatch(rel, pat) for pat in config["exempt"])


def run_tests(config, root):
    """Return (passed, tail of output)."""
    try:
        out = subprocess.run(config["test_command"], shell=True, cwd=root, capture_output=True,
                             text=True, timeout=config["test_timeout"])
    except subprocess.TimeoutExpired:
        return False, f"timed out after {config['test_timeout']}s"
    tail = "\n".join((out.stdout + out.stderr).strip().splitlines()[-30:])
    return out.returncode == 0, tail


def git_out(root, *args, stdin=None):
    out = subprocess.run(["git", *args], cwd=root, input=stdin, capture_output=True, text=True,
                         errors="surrogateescape")
    return out.stdout if out.returncode == 0 else None


def tree_fingerprint(config, root):
    """Return (code, full, dirty) for the working tree as it stands.

    `code` hashes the non-exempt files, `full` every file, and `dirty` says whether a non-exempt file is
    uncommitted. Blob ids come from the index for unchanged files and from `git hash-object` for changed
    ones, so a tree has the same fingerprint just before a commit and just after it, and nothing is
    written to the repo. Both hashes are None when git cannot give them; callers then run the tests.
    """
    listed = git_out(root, "ls-files", "-s", "-z")
    status = git_out(root, "status", "--porcelain", "-z", "--untracked-files=all")
    if listed is None or status is None:
        return None, None, False
    blobs = {}
    for entry in listed.split("\0"):
        meta, _, rel = entry.partition("\t")
        if rel:
            blobs[rel] = meta.split()[1]
    changed, fields = [], status.split("\0")
    i = 0
    while i < len(fields):
        entry = fields[i]
        i += 1
        if len(entry) < 4:
            continue
        changed.append(entry[3:])
        if entry[0] in "RC":
            changed.append(fields[i])  # the rename source follows as its own field
            i += 1
    to_hash = []
    for rel in changed:
        path = os.path.join(root, rel)
        if os.path.islink(path):
            blobs[rel] = "link:" + os.readlink(path)
        elif os.path.isfile(path):
            to_hash.append(rel)
        elif os.path.isdir(path):
            blobs[rel] = "dir"
        else:
            blobs.pop(rel, None)
    if to_hash:
        hashed = git_out(root, "hash-object", "--stdin-paths", stdin="\n".join(to_hash) + "\n")
        ids = hashed.split() if hashed is not None else []
        if len(ids) != len(to_hash):
            return None, None, True
        blobs.update(zip(to_hash, ids))
    code, full = hashlib.sha256(), hashlib.sha256()
    for rel in sorted(blobs):
        line = f"{rel}\0{blobs[rel]}\0".encode("utf-8", "surrogateescape")
        full.update(line)
        if not exempt(config, rel):
            code.update(line)
    return code.hexdigest(), full.hexdigest(), any(not exempt(config, rel) for rel in changed)


def ensure_green(config, root, state, force=False):
    """Run the tests unless these files already passed them. Return (passed, tail of output, ran)."""
    if not force:
        code = tree_fingerprint(config, root)[0]
        if code and code == state["green"]:
            return True, "", False
    passed, tail = run_tests(config, root)
    # Fingerprint after the run: it may itself leave files behind (coverage, caches).
    code, full, _ = tree_fingerprint(config, root)
    if passed:
        state["green"], state["red"] = code, None
    else:
        state["red"] = full
    return passed, tail, True


def emit(obj):
    print(json.dumps(obj))


def hook_pre_tool(event, root, config):
    tool, tool_input = event.get("tool_name"), event.get("tool_input") or {}
    enforce = config["enforce"]
    if tool == "Bash" and GIT_COMMIT.search(tool_input.get("command", "")):
        level = enforce["tests_before_commit"]
        if level == "off" or not config["test_command"]:
            return 0
        state = load_state(root)
        passed, tail, ran = ensure_green(config, root, state)
        if ran:
            save_state(root, state)
        if passed:
            return 0
        msg = f"supermatt: tests fail, so this commit is {'blocked' if level == 'block' else 'unverified'}.\n" \
              f"$ {config['test_command']}\n{tail}"
        return block_or_warn(level, msg, "PreToolUse")
    if tool in EDIT_TOOLS:
        level = enforce["ticket_before_code"]
        path = tool_input.get("file_path") or tool_input.get("notebook_path")
        if level == "off" or not path:
            return 0
        path = os.path.realpath(os.path.join(event.get("cwd") or root, path))
        if not path.startswith(root + os.sep):
            return 0
        if exempt(config, os.path.relpath(path, root)):
            return 0
        state = load_state(root)
        if state["ticket"] and state["tickets"].get(state["ticket"]) in ("implementing", "needs-review"):
            return 0
        msg = ("supermatt: no ticket is in progress, so code edits are "
               f"{'blocked' if level == 'block' else 'off-plan'}. Start one first "
               "(`supermatt ticket <id> implementing`, or /supermatt:run for a feature). "
               "Only the user decides whether to relax enforce.ticket_before_code.")
        return block_or_warn(level, msg, "PreToolUse")
    return 0


def hook_stop(event, root, config):
    state = load_state(root)
    enforce = config["enforce"]
    blocks, warns = [], []
    active = state["tickets"].get(state["ticket"]) if state["ticket"] else None
    if active == "blocked":
        return 0  # waiting on the user: asking is the point of this turn
    pending = sorted(t for t, s in state["tickets"].items() if s == "needs-review")
    if pending and enforce["review_after_ticket"] != "off":
        msg = f"ticket {', '.join(pending)} is committed but not reviewed; run /supermatt:review."
        (blocks if enforce["review_after_ticket"] == "block" else warns).append(msg)
    level = enforce["green_before_stop"]
    # Mid-ticket red is part of test-first work; the commit rule guards the ticket's end.
    if level != "off" and config["test_command"] and active != "implementing":
        code, full, dirty = tree_fingerprint(config, root)
        if dirty and full and full == state["red"]:
            # Blocking again would only repeat the last turn: nothing has changed since that red run.
            warns.append("uncommitted changes still fail the tests (no file has changed since the last failing run).")
        elif dirty and not (code and code == state["green"]):
            passed, tail, _ = ensure_green(config, root, state, force=True)
            if not passed:
                msg = f"uncommitted changes fail the tests.\n$ {config['test_command']}\n{tail}"
                (blocks if level == "block" else warns).append(msg)
    if blocks and state["stop_blocks"] < MAX_STOP_BLOCKS:
        state["stop_blocks"] += 1
        save_state(root, state)
        print("supermatt: not done yet.\n- " + "\n- ".join(blocks), file=sys.stderr)
        return 2
    if blocks:
        warns = [f"stopped blocking after {MAX_STOP_BLOCKS} attempts"] + blocks + warns
    state["stop_blocks"] = 0
    if state != load_state(root):
        save_state(root, state)
    if warns:
        emit({"systemMessage": "supermatt: " + "\n- ".join(warns)})
    return 0


def hook_session_start(event, root, config):
    state = load_state(root)
    if not state["feature"] or state["stage"] == "done":
        return 0
    ticket = f", ticket {state['ticket']} ({state['tickets'].get(state['ticket'])})" if state["ticket"] else ""
    emit({"hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": f"supermatt: feature {state['feature']} is at stage {state['stage']}{ticket}. "
                             "Resume it with /supermatt:run when the user wants to continue.",
    }})
    return 0


def block_or_warn(level, msg, event_name):
    if level == "block":
        print(msg, file=sys.stderr)
        return 2
    emit({"hookSpecificOutput": {"hookEventName": event_name, "additionalContext": msg}, "systemMessage": msg})
    return 0


HOOKS = {"pre-tool": hook_pre_tool, "stop": hook_stop, "session-start": hook_session_start}


def cmd_hook(args, root):
    """Hooks never fail the session: bad input, a broken config or a bug all end in exit 0."""
    try:
        event = json.load(sys.stdin)
    except ValueError:
        event = {}
    if not isinstance(event, dict):
        event = {}
    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
    if args.event == "pre-tool" and event.get("tool_name") == "Bash" \
            and not GIT_COMMIT.search(str(tool_input.get("command", ""))):
        return 0  # the common case, decided before touching git or the disk
    try:
        root = repo_root(event.get("cwd") or os.getcwd())
        try:
            config = load_config(root)
        except UsageError as e:
            return session_notice(args.event, f"supermatt is off in this repo: {e}")
        if config is None:
            return 0
        if not is_trusted(root):
            return session_notice(args.event, (
                f"supermatt is off in this repo: this machine has not trusted its {CONFIG}, which runs "
                f"`{config['test_command'] or '(no test command)'}` from hooks. Review the file, then run "
                "`supermatt trust` (or ask Claude to)."))
        return HOOKS[args.event](event, root, config)
    except Exception as e:  # noqa: BLE001 - report, never break the user's session
        emit({"systemMessage": f"supermatt hook error ({args.event}): {type(e).__name__}: {e}"})
        return 0


def session_notice(event_name, msg):
    """Tell the user once per session (at start) why supermatt is inactive; stay silent elsewhere."""
    if event_name == "session-start":
        emit({"systemMessage": msg, "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": msg}})
    return 0


# ---------- entry point ----------

def main(argv=None):
    parser = argparse.ArgumentParser(prog="supermatt", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="opt this repo in: write .supermatt/config.json")
    p.add_argument("--preset", choices=PRESETS, default="standard")
    p.add_argument("--test-command")
    p.add_argument("--force", action="store_true")
    p = sub.add_parser("config", help="show or change an option (dotted key), or `config preset <name>`")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p = sub.add_parser("status", help="show the pipeline state and options")
    p.add_argument("--json", action="store_true")
    sub.add_parser("trust", help="trust this repo's config on this machine so its hooks run")
    p = sub.add_parser("base", help="record the branch the active feature started from")
    p.add_argument("branch")
    p = sub.add_parser("start", help="start a feature in the pipeline")
    p.add_argument("feature")
    p.add_argument("--stage", choices=STAGES[:-1], default=STAGES[0],
                   help="the stage to start at, when earlier stages were done outside the pipeline")
    p = sub.add_parser("stage", help="record the pipeline stage")
    p.add_argument("stage", choices=STAGES)
    p = sub.add_parser("test", help="run the test command, unless these files already passed it")
    p.add_argument("--force", action="store_true", help="rerun even when these files already passed")
    p = sub.add_parser("ticket", help="record a ticket's state")
    p.add_argument("id")
    p.add_argument("status", choices=TICKET_STATES)
    p = sub.add_parser("hook", help="run as a Claude Code hook (reads the event on stdin)")
    p.add_argument("event", choices=HOOKS)
    args = parser.parse_args(argv)
    commands = {"init": cmd_init, "config": cmd_config, "status": cmd_status, "start": cmd_start,
                "stage": cmd_stage, "test": cmd_test, "ticket": cmd_ticket, "trust": cmd_trust, "base": cmd_base, "hook": cmd_hook}
    try:
        return commands[args.cmd](args, repo_root(os.getcwd())) or 0
    except UsageError as e:
        print(f"supermatt: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
